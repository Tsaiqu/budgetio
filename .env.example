# Skopiuj do .env i uzupełnij:  cp .env.example .env
# .env jest w .gitignore i nigdy nie trafia do repozytorium.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=budgetio
POSTGRES_PASSWORD=budgetio
POSTGRES_DB=budgetio
# zmień, jeśli masz już Postgresa na 5432
POSTGRES_PORT=5432

# --- Baza dla Prismy i aplikacji ---
# Musi zgadzać się z wartościami powyżej.
DATABASE_URL=postgresql://budgetio:budgetio@localhost:5432/budgetio?schema=public

# --- apps/api ---
# API_PORT, a nie PORT: `next dev` czyta PORT z tego samego pliku, więc wspólna
# zmienna oznaczałaby, że web i api walczą o ten sam port. Web zostaje na
# swoim domyślnym 3000.
API_PORT=3333
HOST=localhost
# lokalnie dowolny ciąg; na produkcji świeży, losowy: openssl rand -base64 32
JWT_SECRET=zmien-mnie-na-losowy-ciag
